---
// A scroll bar made from the Atlas logo (Czech pages only).
// The handle is the coral stripe of the logo, with slanted ends. The track is the grey of the round map symbol.
// The bar is flush with the right edge and starts right below the header. It replaces the native bar only for a mouse on a wide screen.
// It is drawn for the eye and hidden from screen readers. The page still scrolls with the wheel and the keyboard.
---
<div class="logo-scroll" aria-hidden="true">
  <div class="ls-track"></div>
  <div class="ls-thumb"></div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>(".logo-scroll");
  const thumb = bar?.querySelector<HTMLElement>(".ls-thumb");
  if (bar && thumb) {
    const root = document.documentElement;
    const wide = matchMedia("(hover: hover) and (pointer: fine) and (min-width: 900px)");
    const MIN_HANDLE = 56;
    let frame = 0;
    const range = () => root.scrollHeight - innerHeight;

    const update = () => {
      frame = 0;
      const max = range();
      bar.classList.toggle("is-idle", max <= 4);
      const track = bar.clientHeight;
      // The handle is as long as the part of the page you see, like a normal scroll bar.
      const handle = Math.min(track, Math.max(MIN_HANDLE, (innerHeight / root.scrollHeight) * track));
      const fraction = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      bar.style.setProperty("--th", `${handle.toFixed(1)}px`);
      bar.style.setProperty("--p", fraction.toFixed(4));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    new ResizeObserver(schedule).observe(document.body);

    // The bar starts at the lower edge of the header. The header gets lower while it shrinks on scroll, so follow its size.
    const header = document.querySelector<HTMLElement>(".site-header");
    const place = () => {
      bar.style.setProperty("--ls-top", `${header ? header.offsetHeight : 0}px`);
      schedule();
    };
    if (header) new ResizeObserver(place).observe(header);
    place();
    update();

    // Drag the handle. Press the track to bring the handle there, then keep dragging.
    let dragging = false;
    let startY = 0;
    let startScroll = 0;
    const usable = () => bar.clientHeight - thumb.getBoundingClientRect().height;
    bar.addEventListener("pointerdown", (event) => {
      if (!wide.matches || event.button !== 0) return;
      dragging = true;
      bar.setPointerCapture(event.pointerId);
      bar.classList.add("is-drag");
      if (!thumb.contains(event.target as Node)) {
        const box = bar.getBoundingClientRect();
        const height = thumb.getBoundingClientRect().height;
        const fraction = Math.min(1, Math.max(0, (event.clientY - box.top - height / 2) / usable()));
        scrollTo({ top: fraction * range(), behavior: "instant" });
      }
      startY = event.clientY;
      startScroll = scrollY;
      event.preventDefault();
    });
    bar.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const room = usable();
      if (room > 0) scrollTo({ top: startScroll + ((event.clientY - startY) * range()) / room, behavior: "instant" });
    });
    const stop = () => { dragging = false; bar.classList.remove("is-drag"); };
    bar.addEventListener("pointerup", stop);
    bar.addEventListener("pointercancel", stop);
  }
</script>
