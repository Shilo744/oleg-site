---
// Small line icons for the four process steps (Czech page only). Decoration.
const { index = 0 } = Astro.props;
---
<svg class="step-icon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
  {index === 0 && (
    <>
      <path class="draw" pathLength="1" d="M5 12H35M5 20H35M5 28H35" />
      <rect class="sq" x="11" y="9" width="6" height="6" />
      <rect class="sq sq-c" x="23" y="17" width="6" height="6" />
      <rect class="sq" x="15" y="25" width="6" height="6" />
    </>
  )}
  {index === 1 && (
    <>
      <rect class="sq" x="17" y="27" width="6" height="8" />
      <path class="draw" pathLength="1" d="M12 22a8 8 0 0 1 16 0M7 22a13 13 0 0 1 26 0" />
      <rect class="sq sq-c" x="18" y="19" width="4" height="4" />
    </>
  )}
  {index === 2 && (
    <>
      <circle class="draw" pathLength="1" cx="17" cy="17" r="10" />
      <path class="draw" pathLength="1" d="M24.5 24.5L35 35" />
      <path class="draw" pathLength="1" d="M12 15H22M12 19H19" />
      <rect class="sq sq-c" x="29" y="8" width="4" height="4" />
    </>
  )}
  {index === 3 && (
    <>
      <rect class="draw" pathLength="1" x="6" y="6" width="28" height="28" />
      <path class="draw arrow" pathLength="1" d="M14 26L26 14M17 14H26V23" />
    </>
  )}
</svg>
