---
import Logo from "./Logo.astro";
import { markets, marketPath, equivalentMarketPath } from "../data/markets.js";
const { market, pathname, content = {} } = Astro.props;
const home = marketPath(market);
const labels = {
  howItWorks: content.howItWorks || "How it works",
  sample: content.sample || "Sample opportunity",
  pilot: content.pilot || "The pilot",
  about: content.about || "About",
  contact: content.contact || "Contact",
  menu: content.menu || "Menu",
  countryLabel: content.countryLabel || "Choose country",
};
---

<header class="site-header" data-glass="1.03">
  <div class="container header-inner">
    <Logo href={home} /><button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="navigation">{labels.menu} <span aria-hidden="true">☰</span></button
    ><nav id="navigation" aria-label="Main navigation">
      <a href={`${home}#how-it-works`}>{labels.howItWorks}</a><a href={marketPath(market, "/sample-opportunity/")}
        >{labels.sample}</a
      ><a href={`${home}#pilot`}>{labels.pilot}</a><a href={marketPath(market, "/about/")}>{labels.about}</a><div class="country-switcher" aria-label={labels.countryLabel}>
        <a href={equivalentMarketPath(markets.uk, pathname)} aria-current={market.id === "uk" ? "page" : undefined}>UK</a>
        <span aria-hidden="true">/</span>
        <a href={equivalentMarketPath(markets.cz, pathname)} aria-current={market.id === "cz" ? "page" : undefined}>CZ</a>
        <span aria-hidden="true">/</span>
        <a href={equivalentMarketPath(markets.de, pathname)} aria-current={market.id === "de" ? "page" : undefined}>DE</a>
      </div><a
        class="nav-contact"
        href={marketPath(market, "/contact/")}>{labels.contact} <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#navigation");
  // Switch the glass header to a dark tone while it is over a dark section.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    let waiting = false;
    const luminance = (colour: string) => {
      const [r, g, b, a = "1"] = (colour.match(/[\d.]+/g) || []);
      return Number(a) < 0.5 ? null : (0.2126 * Number(r) + 0.7152 * Number(g) + 0.0722 * Number(b)) / 255;
    };
    const check = () => {
      waiting = false;
      const probe = Math.min(header.getBoundingClientRect().height - 6, 40);
      let dark = false;
      for (const found of document.elementsFromPoint(innerWidth / 2, probe)) {
        if (header.contains(found)) continue;
        let node: Element | null = found;
        let value: number | null = null;
        while (node && value === null) {
          value = luminance(getComputedStyle(node).backgroundColor);
          node = node.parentElement;
        }
        if (value !== null) { dark = value < 0.35; break; }
      }
      header.classList.toggle("is-dark", dark);
    };
    const schedule = () => { if (!waiting) { waiting = true; requestAnimationFrame(check); } };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    check();
  }
  if (button && nav) {
    document.documentElement.classList.add("has-js");
    const close = () => {
      button.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    };
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
    });
    nav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        button.getAttribute("aria-expanded") === "true"
      ) {
        close();
        button.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (!(event.target as HTMLElement).closest(".site-header")) close();
    });
  }
</script>
