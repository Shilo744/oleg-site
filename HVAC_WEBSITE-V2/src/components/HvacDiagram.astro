---
// A section drawing of a fictional hotel with the four HVAC prompts of the sample brief (Czech page only).
// The drawing is decoration. The numbered list beside it carries the same text, so the drawing is hidden from screen readers.
const { content } = Astro.props;
if (!content) return;
const top = 96;
const floorHeight = 36;
const floors = [0, 1, 2, 3, 4, 5];
const leftWindows = [0, 1, 2, 3, 4].map((j) => 96 + j * 30);
const rightWindows = [0, 1, 2, 3, 4, 5].map((j) => 330 + j * 28);
const markers = [
  { n: 1, x: 172, y: 324 },
  { n: 2, x: 222, y: 330 },
  { n: 3, x: 346, y: 60 },
  { n: 4, x: 424, y: 324 },
];
---
<figure class="diagram" data-reveal>
  <div class="d-head">
    <div class="eyebrow">{content.eyebrow}</div>
    <h2>{content.title.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2>
    <p>{content.intro}</p>
  </div>
  <div class="d-body">
    <div class="illus illus-wide" aria-hidden="true">
      <svg class="v-hotel" viewBox="30 30 580 370" focusable="false">
        <defs>
          <pattern id="hv-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="8" stroke="#c4cacf" stroke-width="1" />
          </pattern>
        </defs>
        <!-- ground -->
        <rect x="0" y="312" width="80" height="88" fill="url(#hv-hatch)" />
        <rect x="520" y="312" width="120" height="88" fill="url(#hv-hatch)" />
        <rect x="80" y="372" width="440" height="28" fill="url(#hv-hatch)" />
        <!-- building -->
        <rect class="fl-w" x="80" y="96" width="440" height="216" />
        <rect class="fl-g" x="80" y="312" width="440" height="60" />
        <path class="ln-g draw" pathLength="1" d="M80 132H520M80 168H520M80 204H520M80 240H520M80 276H520" style="--dl:.5s" />
        {floors.map((i) => (
          <>
            {leftWindows.map((x) => <rect class="win fade" x={x} y={top + floorHeight * i + 14} width="18" height="14" style={`--dl:${0.9 + i * 0.08}s`} />)}
            {rightWindows.map((x) => <rect class="win fade" x={x} y={top + floorHeight * i + 14} width="18" height="14" style={`--dl:${0.9 + i * 0.08}s`} />)}
          </>
        ))}
        <!-- service shaft, ducts, pipes -->
        <rect class="shaft" x="268" y="96" width="44" height="276" />
        <path class="duct fade" d="M104 103H500M104 139H500M104 175H500M104 211H500M104 247H500M104 283H500M298 96V290" style="--dl:1.2s" />
        <path class="pipe pipe-flow fade" d="M168 340H188M218 340H276V104" data-flow="10 9.09" style="--dl:1.4s" />
        <path class="pipe pipe-return fade" d="M284 104V360H168" data-flow="10 9.09" style="--dl:1.4s" />
        <!-- roof plant: ventilation -->
        <g class="feat feat-3">
          <rect class="hl fl-w" x="250" y="60" width="96" height="36" />
          <path class="ln-g" d="M302 68H338M302 74H338M302 80H338M302 86H338M302 92H338" />
          <circle class="ln-g" cx="278" cy="78" r="13" />
          <g class="fan"><path d="M278 66V90M267.6 72L288.4 84M267.6 84L288.4 72" /></g>
          <rect class="hl fl-w" x="366" y="48" width="14" height="48" />
          <path class="ln" d="M362 48H384M346 84H366" />
        </g>
        <!-- basement: heating plant -->
        <g class="feat feat-1">
          <rect class="hl fl-w" x="100" y="324" width="68" height="44" />
          <path class="ln" d="M150 324V314M146 314H154" />
          <circle class="ln-g" cx="118" cy="352" r="6" />
          <path class="flame" d="M118 358C112 354 113 348 118 342C119 346 124 348 123 353C122 356 120 357 118 358Z" />
          <path class="ln-g" d="M134 336H160M134 342H160" />
        </g>
        <!-- basement: hot water -->
        <g class="feat feat-2">
          <rect class="hl fl-w" x="188" y="330" width="30" height="38" />
          <path class="ln-g" d="M194 340H212M194 346H212M194 352H212M194 358H212" />
        </g>
        <!-- basement: controls -->
        <g class="feat feat-4">
          <rect class="hl fl-w" x="340" y="324" width="84" height="44" />
          <rect class="fl-g" x="348" y="332" width="40" height="16" />
          <circle class="dot-c" cx="398" cy="340" r="2.6" />
          <circle class="dot-b" cx="407" cy="340" r="2.6" />
          <circle class="dot-b" cx="416" cy="340" r="2.6" />
          <rect class="key" x="348" y="356" width="12" height="6" />
          <rect class="key" x="364" y="356" width="12" height="6" />
          <rect class="key" x="380" y="356" width="12" height="6" />
          <path class="ctl fade" d="M382 324V318H508V78H346" style="--dl:1.6s" />
          {floors.map((i) => <g class="sensor" style={`--i:${i}`}><rect class="sensor-base" x="505" y={top + floorHeight * i + 18} width="6" height="6" /><rect class="sensor-on" x="505.5" y={top + floorHeight * i + 18.5} width="5" height="5" /></g>)}
        </g>
        <!-- outlines, drawn last so they stay crisp -->
        <rect class="ln draw" pathLength="1" x="80" y="96" width="440" height="276" />
        <path class="ln draw" pathLength="1" d="M0 312H640" style="--dl:.2s" />
        <rect class="ln draw" pathLength="1" x="250" y="60" width="96" height="36" style="--dl:.7s" />
        <rect class="ln draw" pathLength="1" x="366" y="48" width="14" height="48" style="--dl:.8s" />
        <rect class="ln draw" pathLength="1" x="100" y="324" width="68" height="44" style="--dl:.9s" />
        <rect class="ln draw" pathLength="1" x="188" y="330" width="30" height="38" style="--dl:.95s" />
        <rect class="ln draw" pathLength="1" x="340" y="324" width="84" height="44" style="--dl:1s" />
        <!-- markers -->
        {markers.map(({ n, x, y }) => (
          <g class={`mk mk-${n}`} style={`--i:${n - 1}`}>
            <rect x={x - 8} y={y - 8} width="16" height="16" />
            <text x={x} y={y + 3.4} text-anchor="middle">{n}</text>
          </g>
        ))}
      </svg>
    </div>
    <ol class="d-list">
      {content.items.map(([title, body], i) => (
        <li class="d-item" data-k={i + 1}>
          <span class="d-num">{i + 1}</span>
          <div><h3>{title}</h3><p>{body}</p></div>
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="d-cap">{content.caption}</figcaption>
</figure>
