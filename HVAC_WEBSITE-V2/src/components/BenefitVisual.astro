---
// Line drawings for the three "What you receive" columns (Czech page only).
// They are decoration. The text in the column says the same, so they are hidden from screen readers.
// index 0: signals matched against your business. 1: a brief that keeps facts, interpretation and open questions apart.
// index 2: the path to a next action.
const { index = 0, labels = {}, reveal = false } = Astro.props;
const text = {
  match: "Match", filtered: "Filtered out",
  facts: "Facts", interpretation: "Interpretation", open: "Open questions",
  contractor: "Contractor", package: "Package", next: "Next action", drop: "Not worth it",
  ...(labels.signals || {}), ...(labels.brief || {}), ...(labels.path || {}),
};
const grey = [[116, 56], [206, 58], [100, 104], [222, 106], [150, 138], [188, 36], [228, 76], [94, 80], [176, 126], [134, 92], [158, 62], [112, 128]];
const hits = [[198, 70], [122, 114], [190, 112]];
---
<div class="illus" aria-hidden="true" data-reveal={reveal ? "" : undefined}>
  {index === 0 && (
    <svg class="v-radar" viewBox="0 0 320 200" focusable="false">
      <circle class="ln-g draw" pathLength="1" cx="160" cy="92" r="76" />
      <circle class="ln-g draw" pathLength="1" cx="160" cy="92" r="51" style="--dl:.15s" />
      <circle class="ln-g draw" pathLength="1" cx="160" cy="92" r="26" style="--dl:.3s" />
      <path class="ln-g draw" pathLength="1" d="M76 92H244M160 8V176" style="--dl:.2s" />
      <g class="sweep">
        <path d="M160 92V16A76 76 0 0 1 213.7 38.3Z" class="sweep-fill" />
        <path d="M160 92L213.7 38.3" class="sweep-edge" />
      </g>
      {grey.map(([x, y], i) => <rect class="blip fade" x={x - 2.5} y={y - 2.5} width="5" height="5" style={`--dl:${0.5 + i * 0.05}s`} />)}
      {hits.map(([x, y], i) => (
        <g class="hit" style={`--i:${i}`}>
          <circle class="hit-ring" cx={x} cy={y} r="6" />
          <rect class="hit-sq" x={x - 4} y={y - 4} width="8" height="8" />
        </g>
      ))}
      <rect x="14" y="186" width="6" height="6" class="fl-c" />
      <text x="26" y="192">{text.match}</text>
      <rect x="80" y="186" width="6" height="6" class="fl-b" />
      <text x="92" y="192">{text.filtered}</text>
    </svg>
  )}
  {index === 1 && (
    <svg class="v-brief" viewBox="0 0 320 200" focusable="false">
      <rect class="fl-g sheet-back" x="92" y="22" width="172" height="172" />
      <rect class="fl-w ln" x="70" y="10" width="172" height="176" />
      <rect class="fl-c" x="84" y="24" width="8" height="8" />
      <rect class="bar fl-n" x="100" y="26" width="76" height="4" style="--dl:.2s" />
      <rect class="bar fl-b" x="100" y="33" width="46" height="3" style="--dl:.3s" />
      <path class="ln-g" d="M84 46H228" />

      <text x="84" y="60">{text.facts}</text>
      <path class="tick" d="M84 68l2.6 2.6 5-5.4" />
      <rect class="bar fl-n" x="98" y="67" width="128" height="4" style="--dl:.45s" />
      <path class="tick" d="M84 80l2.6 2.6 5-5.4" />
      <rect class="bar fl-n" x="98" y="79" width="98" height="4" style="--dl:.55s" />

      <text x="84" y="104">{text.interpretation}</text>
      <rect class="bar fl-b" x="84" y="111" width="136" height="4" style="--dl:.75s" />
      <rect class="bar fl-b" x="84" y="121" width="104" height="4" style="--dl:.85s" />

      <text x="84" y="146">{text.open}</text>
      <rect class="q-box" x="84" y="153" width="9" height="9" />
      <text class="q" x="86.4" y="160.6">?</text>
      <path class="dash fade" d="M100 158H226" style="--dl:1.1s" />
      <rect class="q-box" x="84" y="168" width="9" height="9" />
      <text class="q" x="86.4" y="175.6">?</text>
      <path class="dash fade" d="M100 173H196" style="--dl:1.25s" />
    </svg>
  )}
  {index === 2 && (
    <svg class="v-path" viewBox="0 0 320 200" focusable="false">
      <path class="ln-g draw" pathLength="1" d="M102 41H112V100H122" />
      <path class="ln-g draw" pathLength="1" d="M210 100H216V159H222" style="--dl:.35s" />
      <path class="dash fade" d="M166 117V159H102" style="--dl:.9s" />
      <rect class="fl-w ln" x="14" y="24" width="88" height="34" />
      <rect class="fl-w ln" x="122" y="83" width="88" height="34" />
      <rect class="fl-c node-next" x="222" y="142" width="88" height="34" />
      <rect class="fl-w ln-g node-drop" x="14" y="142" width="88" height="34" />
      <text class="nt" x="58" y="44.5" text-anchor="middle">{text.contractor}</text>
      <text class="nt" x="166" y="103.5" text-anchor="middle">{text.package}</text>
      <text class="nt nt-c" x="266" y="162.5" text-anchor="middle">{text.next}</text>
      <text class="nt nt-g" x="58" y="162.5" text-anchor="middle">{text.drop}</text>
      <circle class="travel" cx="102" cy="41" r="3.2" />
    </svg>
  )}
</div>
