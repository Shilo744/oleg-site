---
import "@fontsource-variable/manrope";
import legacyStyles from "../styles/global.css?inline";
import v3Styles from "../styles/atlas-v3.css?inline";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SizingTuner from "../components/SizingTuner.astro";
import { site } from "../data/site.js";
import { getMarket } from "../data/markets.js";
const { title, description, marketId = "uk", content, design = marketId !== "de" ? "v3" : undefined } = Astro.props;
const market = getMarket(marketId);
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : null;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{title} | Atlas</title><meta
      name="description"
      content={description}
    /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{
      canonical && <link rel="canonical" href={canonical} />
    }<meta property="og:title" content={`${title} | Atlas`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" /><meta
      property="og:locale"
      content={market.locale}
    />{canonical && <meta property="og:url" content={canonical} />}{
      site.url && (
        <>
          <>
            <meta
              property="og:image"
              content={new URL("/og.png", site.url).href}
            />
            <meta
              property="og:image:alt"
              content={`Atlas — ${market.descriptor}`}
            />
            <meta name="twitter:card" content="summary_large_image" />
            <meta
              name="twitter:image"
              content={new URL("/og.png", site.url).href}
            />
          </>
        </>
      )
    }<meta
      name="robots"
      content={site.url ? "index, follow" : "noindex, nofollow"}
    /><style is:global set:html={design === "v3" ? v3Styles : legacyStyles} /></head
  ><body data-market={market.id} data-design={design}
    ><a class="skip-link" href="#main">Skip to content</a><Header market={market} pathname={Astro.url.pathname} content={content?.navigation} design={design} /><main
      id="main"
    >
      <slot />
    </main><Footer market={market} content={content?.footer} design={design} />{market.id === "cz" && design !== "v3" && <SizingTuner />}</body>
</html>
