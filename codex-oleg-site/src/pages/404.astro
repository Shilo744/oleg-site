---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This Atlas page could not be found. Return to the homepage or explore our sample opportunity."
  ><section class="v3-document-hero">
    <div class="v3-wrap">
      <p class="v3-kicker">404 / Page not found</p><h1>
        This one is<br />off the map.
      </h1><p class="v3-document-lead">
        The page may have moved, or the link may be incorrect.
      </p><div class="v3-actions">
        <a class="v3-button v3-button-coral" href="/">Back to Atlas →</a><a
          class="v3-button v3-button-outline"
          href="/sample-opportunity/">View sample opportunity ↗</a>
      </div>
    </div>
  </section></BaseLayout
>
